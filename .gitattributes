# ==============================================================================
# Ryokourent - Git Attributes Configuration
# Standard line endings and packaging exclusions for production release
# ==============================================================================

# Standardize line endings across operating systems
* text=auto eol=lf
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.dist text eol=lf

# ------------------------------------------------------------------------------
# Export-Ignore: Exclude Development & Testing Files from Production Archive
# (Applied when executing `git archive` for production ZIP creation)
# ------------------------------------------------------------------------------

# Git and Version Control
.git* export-ignore
/.git* export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore

# Environment & Config Example
/.env.example export-ignore
/CONFIG.example.php export-ignore

# Code Quality, Formatting & Linter Configs
/.editorconfig export-ignore
/.eslintrc.json export-ignore
/eslint.config.mjs export-ignore
/.phpcs.xml.dist export-ignore
/tsconfig.json export-ignore
/postcss.config.mjs export-ignore
/next.config.ts export-ignore
/next-env.d.ts export-ignore
/package.json export-ignore
/bun.lock export-ignore
/metadata.json export-ignore

# Next.js Container & Build Directories (if present in repo)
/app/ export-ignore
/hooks/ export-ignore
/lib/ export-ignore
/node_modules/ export-ignore
/.next/ export-ignore

# Patch & Local Docker Development Files
/*.patch export-ignore
/xampp-docker/ export-ignore

# Test Suites and Verification Files
/TESTING.md export-ignore
tests/ export-ignore
tests/** export-ignore
/wp-content/plugins/ryokourent-core/tests/ export-ignore
/wp-content/plugins/ryokourent-core/tests/** export-ignore
/wp-content/plugins/ryokourent-core/.git* export-ignore

# Internal AI Development Prompts & Handover Files
/AI_RULES.md export-ignore
/AI_WORKFLOW.md export-ignore
/SESSION_STATE.md export-ignore
/REVIEW-ARCHITECTURE.md export-ignore
/docs/REVIEW-ARCHITECTURE.md export-ignore
/docs/HANDOVER.md export-ignore
/docs/PRE_MERGE_CHECKLIST.md export-ignore
